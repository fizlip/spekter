# Copy to .env.local and fill in. .env.local is gitignored.

# OpenRouter API key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenRouter model id used for every reply: https://openrouter.ai/models
SPEKTER_MODEL=anthropic/claude-haiku-4.5

# Request log file, one JSON line per chat request. Defaults to logs/requests.jsonl.
# SPEKTER_REQUEST_LOG=logs/requests.jsonl

# Optional: path to a markdown file whose content becomes the system prompt for every reply.
# Relative paths resolve against the directory the server runs from.
# Unset or an empty file sends no instructions; a configured file that cannot be read is an error.
# SPEKTER_SYSTEM_PROMPT=docs/prompts/system.md

# Optional: path to a folder of markdown notes sent to the model on every request.
# Every .md file is included, subfolders too; hidden files and folders, symlinks, and empty notes are skipped.
# Relative paths resolve against the directory the server runs from.
# Unset or a folder with no notes sends no knowledge; a configured folder that cannot be read is an error.
# SPEKTER_KNOWLEDGE_DIR=notes

# Optional: most model steps per request when the model calls tools. Defaults to 5.
# The last step always runs with tools off, so the model answers with what it gathered.
# SPEKTER_MAX_STEPS=5

# Optional: comma-separated folders the file tools (read_file, write_file, edit_file,
# delete_file, list_files) may touch. Paths outside them are rejected. Defaults to
# "skills,knowledge"; relative paths resolve against the directory the server runs from.
# SPEKTER_FILE_DIRS=skills,knowledge

# Discord bot token (bot Interface, `npm run bot`): https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Discord user id allowed to talk to the bot; everyone else is ignored.
DISCORD_ALLOWED_USER_ID=

# Optional: where the Spekter API runs. Defaults to http://127.0.0.1:3000.
# SPEKTER_API_URL=http://127.0.0.1:3000

# Optional: how many recent thread messages the bot sends as conversation history. Defaults to 50.
# DISCORD_HISTORY_LIMIT=50

# Sandbox service (`npm run sandboxd`). Shared secret the daemon, the `sandbox` CLI, and
# Spekter's sandbox tools present; at least 32 characters. Generate: openssl rand -hex 32
SANDBOX_TOKEN=

# Optional: port sandboxd listens on (always 127.0.0.1). Defaults to 3210.
# SANDBOX_PORT=3210

# Optional: sandboxd event log, one JSON line per box lifecycle event. Defaults to logs/sandboxd.jsonl.
# SANDBOX_LOG=logs/sandboxd.jsonl

# Optional: where each box's host workspace lives (<root>/<box-id>/, mounted at /workspace in
# the guest). Guests write here, so it must be outside this repo. Defaults to ~/spekter-workspace.
# SANDBOX_WORKSPACE_ROOT=~/spekter-workspace

# Optional: most boxes alive at once; creates beyond it are refused. Defaults to 4.
# SANDBOX_MAX_BOXES=4

# Optional: seconds a box may sit idle before it is destroyed (its workspace stays). Defaults to 1800.
# SANDBOX_TTL_SECONDS=1800
